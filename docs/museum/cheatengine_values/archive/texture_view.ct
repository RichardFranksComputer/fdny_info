<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="42">
  <CheatEntries>
    
    <!-- HEADER -->
    <CheatEntry>
      <Description>"=== TEXTURE 71 DYNAMIC DETECTION TABLE ==="</Description>
      <Options moHideChildren="1"/>
      <GroupHeader>1</GroupHeader>
      <CheatEntries>
        <CheatEntry>
          <Description>"This table uses CODE INJECTION to find the actual memory location"</Description>
          <VariableType>4 Bytes</VariableType>
          <Address>00000000</Address>
        </CheatEntry>
        <CheatEntry>
          <Description>"Enable 'Capture Effect Object' BEFORE triggering win"</Description>
          <VariableType>4 Bytes</VariableType>
          <Address>00000000</Address>
        </CheatEntry>
      </CheatEntries>
    </CheatEntry>

    <!-- CODE INJECTION -->
    <CheatEntry>
      <Description>"[1] ENABLE THIS: Capture Effect Object at 0x00444dd5"</Description>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
aobscanmodule(texture71Inject,FDNYFirefighter.exe,6A 47 8B 45 FC) // PUSH 47, MOV EAX,[EBP-04]
alloc(captureTexture71,512)
alloc(pEffectObject,4)
alloc(captureCount,4)
label(code)
label(return)

captureTexture71:
  // Save all registers
  pushad
  pushfd
  
  // Increment capture counter
  mov eax,[captureCount]
  inc eax
  mov [captureCount],eax
  
  // The effect object pointer is likely in a register or on stack
  // Check common locations:
  
  // Try ECX (common for 'this' pointer in thiscall)
  cmp ecx,0
  je checkEDI
  mov [pEffectObject],ecx
  jmp captured
  
checkEDI:
  // Try EDI
  cmp edi,0
  je checkStack
  mov [pEffectObject],edi
  jmp captured
  
checkStack:
  // Try [EBP-04] which is in the next instruction
  mov eax,[ebp-04]
  cmp eax,0
  je captured
  mov [pEffectObject],eax
  
captured:
  // Restore all registers
  popfd
  popad
  
  // Original code
code:
  push 47
  mov eax,[ebp-04]
  jmp return

texture71Inject:
  jmp captureTexture71
  nop
return:

registersymbol(pEffectObject)
registersymbol(captureCount)

[DISABLE]
texture71Inject:
  db 6A 47 8B 45 FC

dealloc(captureTexture71)
dealloc(pEffectObject)
dealloc(captureCount)
unregistersymbol(pEffectObject)
unregistersymbol(captureCount)
</AssemblerScript>
    </CheatEntry>

    <!-- CAPTURED VALUES -->
    <CheatEntry>
